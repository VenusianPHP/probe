{
    "name": "venusian/probe",
    "description": "REPL for the Venusian PHP framework.",
    "keywords": ["probe", "repl", "psysh", "venusian"],
    "license": "MIT",
    "version": "0.8.0",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "voyager/console": "^0.8.0",
        "voyager/contracts": "^0.8.0",
        "voyager/nuts-and-bolts": "^0.8.0",
        "psy/psysh": "^0.12.0",
        "symfony/var-dumper": "^5.4|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "mockery/mockery": "~1.3.3|^1.4.2",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5|^11.5"
    },
    "suggest": {
        "venusian/framework": "Required host application framework (^0.8).",
        "voyager/database": "Eloquent model casting when Database is restored (^0.8)."
    },
    "autoload": {
        "psr-4": {
            "Venusian\\Probe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Venusian\\Probe\\Tests\\": "tests/",
            "App\\": "tests/fixtures/app",
            "One\\Two\\": "tests/fixtures/vendor/one/two"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "Venusian\\Probe\\ProbeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
